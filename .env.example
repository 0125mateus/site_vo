SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL online (Supabase). No Render use o pooler IPv4, modo sessão, porta 5432.
# O host sai da tela Connect do projeto; não invente o endereço a partir da região.
# DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require

# Credenciais de TESTE: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-access-token-de-teste
MERCADOPAGO_PUBLIC_KEY=APP_USR-sua-public-key-de-teste
MERCADOPAGO_WEBHOOK_SECRET=
# True = checkout de teste. No Render deixe False (credenciais de produção).
MERCADOPAGO_SANDBOX=True
SITE_URL=http://localhost:8000
# No Render: SITE_URL=https://vinil-e-pagina.onrender.com

# E-mail de confirmação (opcional — sem SMTP imprime no console)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Vinil & Página <noreply@seudominio.com>


# Assistente IA (opcional — sem chave usa modo guiado)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mídia persistente (obrigatório no Render — o disco do plano free some a cada deploy)
# Supabase Storage, bucket público "midia":
# SUPABASE_URL=https://SEU_PROJETO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=midia
# Cloudinary continua aceito se o Supabase não estiver preenchido:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Valide: python manage.py check_mercadopago
# Teste:   python manage.py preparar_teste_compra
# Guia:    docs/TESTE_COMPRA_MP.md
